---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import JsonLd from '../components/JsonLd.astro'
import { person, personId, site } from '../lib/site'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /** Keep the page out of search results, like the 404 and thank-you pages. */
  noindex?: boolean
  /** Structured data for this page, added beside the site's Person and WebSite. */
  schema?: object
}

const { title = site.title, description = site.description, noindex = false, schema } = Astro.props

const origin = Astro.site!
const canonicalURL = new URL(Astro.url.pathname, origin)
const image = new URL(site.image, origin)
const graph = [
  person(origin),
  { '@type': 'WebSite', '@id': new URL('/#website', origin).href, name: site.name, url: origin.href, publisher: { '@id': personId(origin) } },
  ...(schema ? [schema] : []),
]
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- The charset must come within the first 1024 bytes, ahead of the router's scripts. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.jobTitle.toLowerCase()}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {!noindex && <JsonLd data={{ '@context': 'https://schema.org', '@graph': graph }} />}
    <ClientRouter />
    <script>
      import '../lib/navigationCache'
    </script>
    <script is:inline>
      document.documentElement.dataset.menuSide = localStorage.getItem('menu-side') === 'left' ? 'left' : 'right'
      // Prevent flash of wrong theme
      const theme = localStorage.getItem('theme') || 'system'
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      if (theme === 'dark' || (theme === 'system' && systemDark)) {
        document.documentElement.classList.add('dark')
      }
      document.querySelector('meta[name="theme-color"]').content = document.documentElement.classList.contains('dark') ? '#102A43' : '#FFFFFF'
    </script>
  </head>
  <body>
    <div class="page-frame">
      <div class="page-backdrop">
        <div class="page-backdrop-inner">
          <div class="page-backdrop-panel"></div>
        </div>
      </div>
      <div class="page-content">
        <Header />
        <main class="page-main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>

<style>
  :global(html) {
    height: 100%;
    -webkit-font-smoothing: antialiased;
  }
  :global(body) {
    display: flex;
    height: 100%;
  }
  .page-frame {
    display: flex;
    width: 100%;
  }
  .page-backdrop {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;

    @media (width >= 40rem) {
      padding-inline: 2rem;
    }
  }
  .page-backdrop-inner {
    display: flex;
    width: 100%;
    max-width: 80rem;

    @media (width >= 64rem) {
      padding-inline: 2rem;
    }
  }
  .page-backdrop-panel {
    width: 100%;
    background-color: var(--color-surface);
    box-shadow: var(--ring);
  }
  .page-content {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .page-main {
    flex: auto;
  }
</style>
