---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Juan R. Cifuentes - Software designer, founder, and amateur astronaut',
  description = "I'm Juan, a software designer and entrepreneur based in New York City. I'm the founder and CEO of Planetaria, where we develop technologies that empower regular people to explore space on their own terms.",
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <ClientRouter />
    <script>
      import '../lib/navigationCache'
    </script>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Juan R. Cifuentes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.dataset.menuSide = localStorage.getItem('menu-side') === 'left' ? 'left' : 'right'
      // Prevent flash of wrong theme
      const theme = localStorage.getItem('theme') || 'system'
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      if (theme === 'dark' || (theme === 'system' && systemDark)) {
        document.documentElement.classList.add('dark')
      }
      document.querySelector('meta[name="theme-color"]').content = document.documentElement.classList.contains('dark') ? '#102A43' : '#FFFFFF'
    </script>
  </head>
  <body>
    <div class="page-frame">
      <div class="page-backdrop">
        <div class="page-backdrop-inner">
          <div class="page-backdrop-panel"></div>
        </div>
      </div>
      <div class="page-content">
        <Header />
        <main class="page-main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>

<style>
  :global(html) {
    height: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  :global(body) {
    display: flex;
    height: 100%;

    /* Below md, global.css paints the body with the surface colour instead. */
    @media (width >= 48rem) {
      background-color: var(--color-page);
    }
  }

  .page-frame {
    display: flex;
    width: 100%;
  }

  .page-backdrop {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;

    @media (width >= 40rem) {
      padding-inline: 2rem;
    }
  }

  .page-backdrop-inner {
    display: flex;
    width: 100%;
    max-width: 80rem;

    @media (width >= 64rem) {
      padding-inline: 2rem;
    }
  }

  .page-backdrop-panel {
    width: 100%;
    background-color: var(--color-surface);
    box-shadow: var(--ring);
  }

  .page-content {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  .page-main {
    flex: auto;
  }
</style>
