---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Container from '../components/Container.astro'
import Button from '../components/Button.astro'
import Card from '../components/Card.astro'
import CardTitle from '../components/CardTitle.astro'
import CardDescription from '../components/CardDescription.astro'
import CardCta from '../components/CardCta.astro'
import CardEyebrow from '../components/CardEyebrow.astro'
import { formatDate } from '../lib/formatDate'

import logoPlanetaria from '../images/logos/planetaria.svg'
import logoAirbnb from '../images/logos/airbnb.svg'
import logoFacebook from '../images/logos/facebook.svg'
import logoStarbucks from '../images/logos/starbucks.svg'

const allArticles = await getCollection('articles')
const articles = allArticles
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4)

const photos = [
  'https://jr-w-a.juanrcifuentes.com/assets/photos/image-1.jpg',
  'https://jr-w-a.juanrcifuentes.com/assets/photos/image-2.jpg',
  'https://jr-w-a.juanrcifuentes.com/assets/photos/image-3.jpg',
  'https://jr-w-a.juanrcifuentes.com/assets/photos/image-4.jpg',
  'https://jr-w-a.juanrcifuentes.com/assets/photos/image-5.jpg',
]
const rotations = [2, -2, 2, 2, -2]

const resume = [
  { company: 'Planetaria', title: 'CEO', logo: logoPlanetaria, start: '2019', end: { label: 'Present', dateTime: new Date().getFullYear().toString() } },
  { company: 'Airbnb', title: 'Product Designer', logo: logoAirbnb, start: '2014', end: '2019' },
  { company: 'Facebook', title: 'iOS Software Engineer', logo: logoFacebook, start: '2011', end: '2014' },
  { company: 'Starbucks', title: 'Shift Supervisor', logo: logoStarbucks, start: '2008', end: '2011' },
]
---

<BaseLayout>
  <Container class="intro">
    <div class="intro-body">
      <h1 class="headline">
        Software designer, founder, and amateur astronaut.
      </h1>
      <p class="lede">
        I'm Juan, a software designer and entrepreneur based in New York
        City. I'm the founder and CEO of Planetaria, where we develop
        technologies that empower regular people to explore space on their
        own terms.
      </p>
      <div class="social">
        <a class="social-link" href="#" aria-label="Follow on X">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
            <path d="M13.3174 10.7749L19.1457 4H17.7646L12.7039 9.88256L8.66193 4H4L10.1122 12.8955L4 20H5.38119L10.7254 13.7878L14.994 20H19.656L13.3171 10.7749H13.3174ZM11.4257 12.9738L10.8064 12.0881L5.87886 5.03974H8.00029L11.9769 10.728L12.5962 11.6137L17.7652 19.0075H15.6438L11.4257 12.9742V12.9738Z" />
          </svg>
        </a>
        <a class="social-link" href="#" aria-label="Follow on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
            <path d="M12 3c-2.444 0-2.75.01-3.71.054-.959.044-1.613.196-2.185.418A4.412 4.412 0 0 0 4.51 4.511c-.5.5-.809 1.002-1.039 1.594-.222.572-.374 1.226-.418 2.184C3.01 9.25 3 9.556 3 12s.01 2.75.054 3.71c.044.959.196 1.613.418 2.185.23.592.538 1.094 1.039 1.595.5.5 1.002.808 1.594 1.038.572.222 1.226.374 2.184.418C9.25 20.99 9.556 21 12 21s2.75-.01 3.71-.054c.959-.044 1.613-.196 2.185-.419a4.412 4.412 0 0 0 1.595-1.038c.5-.5.808-1.002 1.038-1.594.222-.572.374-1.226.418-2.184.044-.96.054-1.267.054-3.711s-.01-2.75-.054-3.71c-.044-.959-.196-1.613-.419-2.185A4.412 4.412 0 0 0 19.49 4.51c-.5-.5-1.002-.809-1.594-1.039-.572-.222-1.226-.374-2.184-.418C14.75 3.01 14.444 3 12 3Zm0 1.622c2.403 0 2.688.009 3.637.052.877.04 1.354.187 1.67.31.421.163.72.358 1.036.673.315.315.51.615.673 1.035.123.317.27.794.31 1.671.043.95.052 1.234.052 3.637s-.009 2.688-.052 3.637c-.04.877-.187 1.354-.31 1.67-.163.421-.358.72-.673 1.036a2.79 2.79 0 0 1-1.035.673c-.317.123-.794.27-1.671.31-.95.043-1.234.052-3.637.052s-2.688-.009-3.637-.052c-.877-.04-1.354-.187-1.67-.31a2.789 2.789 0 0 1-1.036-.673 2.79 2.79 0 0 1-.673-1.035c-.123-.317-.27-.794-.31-1.671-.043-.95-.052-1.234-.052-3.637s.009-2.688.052-3.637c.04-.877.187-1.354.31-1.67.163-.421.358-.72.673-1.036.315-.315.615-.51 1.035-.673.317-.123.794-.27 1.671-.31.95-.043 1.234-.052 3.637-.052Z" />
            <path d="M12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm0-7.622a4.622 4.622 0 1 0 0 9.244 4.622 4.622 0 0 0 0-9.244Zm5.884-.182a1.08 1.08 0 1 1-2.16 0 1.08 1.08 0 0 1 2.16 0Z" />
          </svg>
        </a>
        <a class="social-link" href="#" aria-label="Follow on GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.475 2 2 6.588 2 12.253c0 4.537 2.862 8.369 6.838 9.727.5.09.687-.218.687-.487 0-.243-.013-1.05-.013-1.91C7 20.059 6.35 18.957 6.15 18.38c-.113-.295-.6-1.205-1.025-1.448-.35-.192-.85-.667-.013-.68.788-.012 1.35.744 1.538 1.051.9 1.551 2.338 1.116 2.912.846.088-.666.35-1.115.638-1.371-2.225-.256-4.55-1.14-4.55-5.062 0-1.115.387-2.038 1.025-2.756-.1-.256-.45-1.307.1-2.717 0 0 .837-.269 2.75 1.051.8-.23 1.65-.346 2.5-.346.85 0 1.7.115 2.5.346 1.912-1.333 2.75-1.05 2.75-1.05.55 1.409.2 2.46.1 2.716.637.718 1.025 1.628 1.025 2.756 0 3.934-2.337 4.806-4.562 5.062.362.32.675.936.675 1.897 0 1.371-.013 2.473-.013 2.82 0 .268.188.589.688.486a10.039 10.039 0 0 0 4.932-3.74A10.447 10.447 0 0 0 22 12.253C22 6.588 17.525 2 12 2Z" />
          </svg>
        </a>
        <a class="social-link" href="#" aria-label="Follow on LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
            <path d="M18.335 18.339H15.67v-4.177c0-.996-.02-2.278-1.39-2.278-1.389 0-1.601 1.084-1.601 2.205v4.25h-2.666V9.75h2.56v1.17h.035c.358-.674 1.228-1.387 2.528-1.387 2.7 0 3.2 1.778 3.2 4.091v4.715zM7.003 8.575a1.546 1.546 0 01-1.548-1.549 1.548 1.548 0 111.547 1.549zm1.336 9.764H5.666V9.75H8.34v8.589zM19.67 3H4.329C3.593 3 3 3.58 3 4.297v15.406C3 20.42 3.594 21 4.328 21h15.338C20.4 21 21 20.42 21 19.703V4.297C21 3.58 20.4 3 19.666 3h.003z" />
          </svg>
        </a>
      </div>
    </div>
  </Container>

  <!-- Photos -->
  <div class="photos">
    <div class="photo-strip">
      {photos.map((image, imageIndex) => (
        <img
          src={image}
          alt=""
          class="photo"
          style={`--rotation: ${rotations[imageIndex % rotations.length]}deg`}
        />
      ))}
    </div>
  </div>

  <Container class="content">
    <div class="content-grid">
      <div class="articles">
        {articles.map((article) => (
          <Card as="article">
            <CardTitle href={`/articles/${article.id}`}>
              {article.data.title}
            </CardTitle>
            <CardEyebrow as="time" dateTime={article.data.date} decorate>
              {formatDate(article.data.date)}
            </CardEyebrow>
            <CardDescription>{article.data.description}</CardDescription>
            <CardCta>Read article</CardCta>
          </Card>
        ))}
      </div>
      <div class="sidebar">
        <!-- Newsletter -->
        <form action="/thank-you" class="panel">
          <h2 class="panel-title">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="panel-icon">
              <path d="M2.75 7.75a3 3 0 0 1 3-3h12.5a3 3 0 0 1 3 3v8.5a3 3 0 0 1-3 3H5.75a3 3 0 0 1-3-3v-8.5Z" class="icon-shape" />
              <path d="m4 6 6.024 5.479a2.915 2.915 0 0 0 3.952 0L20 6" />
            </svg>
            Stay up to date
          </h2>
          <p class="panel-text">
            Get notified when I publish something new, and unsubscribe at any time.
          </p>
          <div class="signup">
            <input
              type="email"
              placeholder="Email address"
              aria-label="Email address"
              required
              class="signup-input"
            />
            <Button type="submit">Join</Button>
          </div>
        </form>

        <!-- Resume -->
        <div class="panel">
          <h2 class="panel-title">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="panel-icon">
              <path d="M2.75 9.75a3 3 0 0 1 3-3h12.5a3 3 0 0 1 3 3v8.5a3 3 0 0 1-3 3H5.75a3 3 0 0 1-3-3v-8.5Z" class="icon-shape" />
              <path d="M3 14.25h6.249c.484 0 .952-.002 1.316.319l.777.682a.996.996 0 0 0 1.316 0l.777-.682c.364-.32.832-.319 1.316-.319H21M8.75 6.5V4.75a2 2 0 0 1 2-2h2.5a2 2 0 0 1 2 2V6.5" />
            </svg>
            Work
          </h2>
          <ol class="roles">
            {resume.map((role) => {
              const startLabel = role.start
              const startDate = role.start
              const endLabel = typeof role.end === 'string' ? role.end : role.end.label
              const endDate = typeof role.end === 'string' ? role.end : role.end.dateTime
              return (
                <li class="role">
                  <div class="role-logo">
                    <img src={role.logo.src} alt="" class="role-logo-image" />
                  </div>
                  <dl class="role-details">
                    <dt class="sr-only">Company</dt>
                    <dd class="role-company">
                      {role.company}
                    </dd>
                    <dt class="sr-only">Role</dt>
                    <dd class="role-title">
                      {role.title}
                    </dd>
                    <dt class="sr-only">Date</dt>
                    <dd class="role-dates" aria-label={`${startLabel} until ${endLabel}`}>
                      <time datetime={startDate}>{startLabel}</time>
                      {' '}<span aria-hidden="true">—</span>{' '}
                      <time datetime={endDate}>{endLabel}</time>
                    </dd>
                  </dl>
                </li>
              )
            })}
          </ol>
          <Button href="#" variant="secondary" class="cv-button">
            Download CV
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="cv-icon">
              <path d="M4.75 8.75 8 12.25m0 0 3.25-3.5M8 12.25v-8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </Button>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
.intro {
  margin-top: 2.25rem;
}

.intro-body {
  max-width: 42rem;
}

.headline {
  font-size: var(--text-4xl);
  line-height: var(--text-4xl--line-height);
  font-weight: 700;
  letter-spacing: var(--tracking-tight);
  color: var(--color-heading);

  @media (width >= 40rem) {
    font-size: var(--text-5xl);
    line-height: var(--text-5xl--line-height);
  }
}

.lede {
  margin-top: 1.5rem;
  font-size: var(--text-base);
  line-height: var(--text-base--line-height);
  color: var(--color-copy);
}

.social {
  display: flex;
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.social-link {
  fill: var(--color-copy);
  transition: var(--transition-colors);

  &:hover {
    fill: var(--color-heading);
  }
}

.social-icon {
  width: 1.5rem;
  height: 1.5rem;
}

/* Photo strip */
.photos {
  margin-top: 4rem;

  @media (width >= 40rem) {
    margin-top: 5rem;
  }
}

/* The padding keeps the rotated corners from being clipped. */
.photo-strip {
  display: flex;
  justify-content: center;
  gap: 1.25rem;
  overflow: hidden;
  margin-block: -1rem;
  padding-block: 1rem;

  @media (width >= 40rem) {
    gap: 2rem;
  }
}

.photo {
  flex: none;
  width: 11rem;
  aspect-ratio: 9 / 10;
  object-fit: cover;
  border-radius: var(--radius-xl);
  background-color: var(--color-page);
  rotate: var(--rotation);

  @media (width >= 40rem) {
    width: 18rem;
    border-radius: var(--radius-2xl);
  }
}

/* Articles + sidebar */
.content {
  margin-top: 6rem;

  @media (width >= 48rem) {
    margin-top: 7rem;
  }
}

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  row-gap: 5rem;
  max-width: 36rem;
  margin-inline: auto;

  @media (width >= 64rem) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: none;
  }
}

.articles,
.sidebar {
  display: flex;
  flex-direction: column;
}

.articles {
  gap: 4rem;
}

.sidebar {
  gap: 2.5rem;

  @media (width >= 64rem) {
    padding-left: 4rem;
  }

  @media (width >= 80rem) {
    padding-left: 6rem;
  }
}

.panel {
  padding: 1.5rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-2xl);
}

.panel-title,
.panel-text,
.role-company {
  font-size: var(--text-sm);
  line-height: var(--text-sm--line-height);
}

.panel-title {
  display: flex;
  gap: 0.75rem;
  font-weight: 600;
  color: var(--color-heading);
  stroke: var(--color-copy);
}

.panel-icon {
  flex: none;
  width: 1.5rem;
  height: 1.5rem;
}

.icon-shape {
  fill: var(--color-page);
}

.panel-text {
  margin-top: 0.5rem;
  color: var(--color-copy);
}

/* Newsletter */
.signup {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 1.5rem;
}

.signup-input {
  flex: auto;
  min-width: 0;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background-color: var(--color-surface);
  box-shadow: var(--shadow-md);

  @media (width >= 40rem) {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  &::placeholder {
    color: var(--color-copy);
  }

  &:focus {
    border-color: var(--color-accent-foreground);
    outline: 3px solid color-mix(in oklab, var(--color-accent-foreground) 25%, transparent);
    outline-offset: 0;
  }
}

/* Resume */
.roles {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: 1.5rem;
}

.role {
  display: flex;
  gap: 1rem;
}

.role-logo {
  display: grid;
  place-items: center;
  flex: none;
  width: 2.5rem;
  height: 2.5rem;
  margin-top: 0.25rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-md);
}

.role-logo-image {
  width: 1.75rem;
  height: 1.75rem;
}

.role-details {
  display: flex;
  flex: auto;
  flex-wrap: wrap;
  column-gap: 0.5rem;
}

.role-company {
  width: 100%;
  font-weight: 500;
  color: var(--color-heading);
}

.role-title,
.role-dates {
  font-size: var(--text-xs);
  line-height: var(--text-xs--line-height);
  color: var(--color-copy);
}

.role-dates {
  margin-left: auto;
}

.cv-button {
  width: 100%;
  margin-top: 1.5rem;
  stroke: var(--color-copy);
}

.cv-icon {
  width: 1rem;
  height: 1rem;
}
</style>
