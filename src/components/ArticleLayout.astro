---
import Container from './Container.astro'
import Prose from './Prose.astro'
import { formatDate } from '../lib/formatDate'

interface Props {
  title: string
  date: string
}

const { title, date } = Astro.props
---

<Container class="mt-16 lg:mt-32">
  <div class="xl:relative">
    <div class="mx-auto max-w-2xl">
      <a
        href="/articles"
        aria-label="Go back to articles"
        class="group mb-8 flex h-10 w-10 items-center justify-center rounded-full bg-surface shadow-md ring-1 shadow-zinc-800/5 ring-border/70 transition lg:absolute lg:-left-5 lg:-mt-2 lg:mb-0 xl:-top-1.5 xl:left-0 xl:mt-0 dark:border dark:border-border dark:ring-0 dark:hover:border-border"
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4 stroke-copy transition group-hover:stroke-control">
          <path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <article>
        <header class="flex flex-col">
          <h1 class="mt-6 text-4xl font-bold tracking-tight text-heading sm:text-5xl">
            {title}
          </h1>
          <time datetime={date} class="order-first flex items-center text-base text-copy">
            <span class="h-4 w-0.5 rounded-full bg-accent"></span>
            <span class="ml-3">{formatDate(date)}</span>
          </time>
        </header>
        <Prose class="mt-8">
          <slot />
        </Prose>
      </article>
    </div>
  </div>
</Container>
