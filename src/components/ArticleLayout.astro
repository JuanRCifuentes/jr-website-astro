---
import Container from './Container.astro'
import Prose from './Prose.astro'
import { formatDate } from '../lib/formatDate'

interface Props {
  title: string
  date: string
}

const { title, date } = Astro.props
---

<Container class="article">
  <div class="article-wrapper">
    <div class="article-column">
      <a
        href="/articles"
        aria-label="Go back to articles"
        class="back-button"
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="back-icon">
          <path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <article>
        <header class="article-header">
          <h1 class="article-title">
            {title}
          </h1>
          <time datetime={date} class="article-date">
            <span class="article-date-bar"></span>
            <span class="article-date-text">{formatDate(date)}</span>
          </time>
        </header>
        <Prose class="article-prose">
          <slot />
        </Prose>
      </article>
    </div>
  </div>
</Container>

<style>
  .article {
    margin-top: 4rem;
  }

  .article-prose {
    margin-top: 2rem;
  }

  .article-column {
    margin-inline: auto;
    max-width: 42rem;
  }

  .back-button {
    margin-bottom: 2rem;
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 3.40282e38px;
    background-color: var(--color-surface);
    box-shadow: var(--ring), var(--shadow-md);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, translate, scale, rotate, filter, backdrop-filter;
    transition-timing-function: var(--ease);
    transition-duration: var(--duration);
  }

  :global(.dark) .back-button {
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .back-icon {
    height: 1rem;
    width: 1rem;
    stroke: var(--color-copy);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, translate, scale, rotate, filter, backdrop-filter;
    transition-timing-function: var(--ease);
    transition-duration: var(--duration);
  }

  @media (hover: hover) {
    .back-button:hover .back-icon {
      stroke: var(--color-control);
    }
  }

  .article-header {
    display: flex;
    flex-direction: column;
  }

  .article-title {
    margin-top: 1.5rem;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }

  .article-date {
    order: -9999;
    display: flex;
    align-items: center;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-copy);
  }

  .article-date-bar {
    height: 1rem;
    width: 0.125rem;
    border-radius: 3.40282e38px;
    background-color: var(--color-accent);
  }

  .article-date-text {
    margin-left: 0.75rem;
  }

  @media (width >= 40rem) {
    .article-title {
      font-size: var(--text-5xl);
      line-height: var(--text-5xl--line-height);
    }
  }

  @media (width >= 64rem) {
    .article {
      margin-top: 8rem;
    }

    .back-button {
      position: absolute;
      left: -1.25rem;
      margin-top: -0.5rem;
      margin-bottom: 0;
    }
  }

  @media (width >= 80rem) {
    .article-wrapper {
      position: relative;
    }

    .back-button {
      top: -0.375rem;
      left: 0;
      margin-top: 0;
    }
  }
</style>
