---
import Container from './Container.astro'
import Prose from './Prose.astro'
import { formatDate } from '../lib/formatDate'

interface Props {
  title: string
  date: string
}

const { title, date } = Astro.props
---

<Container class="article">
  <div class="article-wrapper">
    <div class="article-column">
      <a
        href="/articles"
        aria-label="Go back to articles"
        class="back-button"
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <article>
        <header class="article-header">
          <h1 class="article-title">
            {title}
          </h1>
          <time datetime={date} class="article-date">
            {formatDate(date)}
          </time>
        </header>
        <Prose class="article-prose">
          <slot />
        </Prose>
      </article>
    </div>
  </div>
</Container>

<style>
  .article {
    margin-top: 4rem;
  }
  .article-column {
    margin-inline: auto;
    max-width: 42rem;
  }
  .back-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 2rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    box-shadow: var(--ring), var(--shadow-md);
    stroke: var(--color-copy);
    transition: var(--transition-colors);

    &:hover {
      stroke: var(--color-control);
    }
    svg {
      width: 1rem;
      height: 1rem;
    }
  }
  .article-header {
    display: flex;
    flex-direction: column;
  }
  .article-title {
    margin-top: 1.5rem;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }
  .article-date {
    order: -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    line-height: var(--text-base--line-height);
    color: var(--color-copy);

    &::before {
      content: '';
      width: 0.125rem;
      height: 1rem;
      border-radius: var(--radius-full);
      background-color: var(--color-accent);
    }
  }
  .article-prose {
    margin-top: 2rem;
  }
  @media (width >= 40rem) {
    .article-title {
      font-size: var(--text-5xl);
      line-height: var(--text-5xl--line-height);
    }
  }
  @media (width >= 64rem) {
    .article {
      margin-top: 8rem;
    }
    .back-button {
      position: absolute;
      left: -1.25rem;
      margin: -0.5rem 0 0;
    }
  }
  @media (width >= 80rem) {
    .article-wrapper {
      position: relative;
    }
    .back-button {
      top: -0.375rem;
      left: 0;
      margin-top: 0;
    }
  }
</style>
