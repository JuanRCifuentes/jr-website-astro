---
interface Props {
  variant?: 'primary' | 'secondary'
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props

const variantStyles = {
  primary:
    'bg-control font-semibold text-control-foreground hover:bg-control/90 active:bg-control/80 active:text-control-foreground/70',
  secondary:
    'bg-page font-medium text-heading hover:bg-border active:bg-border active:text-heading/70',
}

const baseStyles = 'inline-flex items-center gap-2 justify-center rounded-md py-2 px-3 text-sm outline-offset-2 transition active:transition-none'
const classes = [baseStyles, variantStyles[variant], className]
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class:list={classes} {...rest}>
    <slot />
  </button>
)}
