---
interface Props {
  variant?: 'primary' | 'secondary'
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props

const classes = ['button', `button-${variant}`, className]
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class:list={classes} {...rest}>
    <slot />
  </button>
)}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    outline-offset: 2px;
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, translate, scale, rotate, filter, backdrop-filter;
    transition-timing-function: var(--ease);
    transition-duration: var(--duration);
  }

  .button:active {
    transition-property: none;
  }

  .button-primary {
    background-color: var(--color-control);
    color: var(--color-control-foreground);
    font-weight: 600;
  }

  .button-secondary {
    background-color: var(--color-page);
    color: var(--color-heading);
    font-weight: 500;
  }

  @media (hover: hover) {
    .button-primary:hover {
      background-color: color-mix(in oklab, var(--color-control) 90%, transparent);
    }

    .button-secondary:hover {
      background-color: var(--color-border);
    }
  }

  .button-primary:active {
    background-color: color-mix(in oklab, var(--color-control) 80%, transparent);
    color: color-mix(in oklab, var(--color-control-foreground) 70%, transparent);
  }

  .button-secondary:active {
    background-color: var(--color-border);
    color: color-mix(in oklab, var(--color-heading) 70%, transparent);
  }
</style>
