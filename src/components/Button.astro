---
interface Props {
  variant?: 'primary' | 'secondary'
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
}

const { variant = 'primary', href, class: className, ...rest } = Astro.props

const classes = ['button', `button-${variant}`, className]
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button class:list={classes} {...rest}>
    <slot />
  </button>
)}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    outline-offset: 2px;
    transition: var(--transition-colors);

    &:active {
      transition: none;
      opacity: 0.8;
    }
  }
  .button-primary {
    background-color: var(--color-control);
    color: var(--color-control-foreground);
    font-weight: 600;

    &:hover {
      background-color: color-mix(in oklab, var(--color-control) 90%, transparent);
    }
  }
  .button-secondary {
    background-color: var(--color-page);
    color: var(--color-heading);
    font-weight: 500;

    &:hover {
      background-color: var(--color-border);
    }
  }
</style>
