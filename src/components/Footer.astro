---
import ContainerOuter from './ContainerOuter.astro'
import ContainerInner from './ContainerInner.astro'

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/uses', label: 'Uses' },
]
---

<footer class="mt-32 flex-none">
  <ContainerOuter>
    <div class="border-t border-border pt-10 pb-16">
      <ContainerInner>
        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm font-medium text-heading">
            {navLinks.map((link) => (
              <a href={link.href} class="transition hover:text-accent-foreground">
                {link.label}
              </a>
            ))}
          </div>
          <p class="text-sm text-copy">
            &copy; {new Date().getFullYear()} Juan R. Cifuentes. All rights reserved.
          </p>
        </div>
      </ContainerInner>
    </div>
  </ContainerOuter>
</footer>
