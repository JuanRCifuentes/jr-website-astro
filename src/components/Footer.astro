---
import ContainerOuter from './ContainerOuter.astro'
import ContainerInner from './ContainerInner.astro'

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/uses', label: 'Uses' },
]
---

<footer class="site-footer">
  <ContainerOuter>
    <div class="footer-body">
      <ContainerInner>
        <div class="footer-row">
          <div class="footer-links">
            {navLinks.map((link) => (
              <a href={link.href} data-astro-prefetch="false" class="footer-link">
                {link.label}
              </a>
            ))}
          </div>
          <p class="footer-copyright">
            &copy; {new Date().getFullYear()} Juan R. Cifuentes. All rights reserved.
          </p>
        </div>
      </ContainerInner>
    </div>
  </ContainerOuter>
</footer>

<style>
  .site-footer {
    margin-top: 8rem;
    flex: none;
  }

  .footer-body {
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .footer-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;

    @media (width >= 48rem) {
      flex-direction: row;
    }
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 500;
    color: var(--color-heading);
  }

  .footer-link {
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, translate, scale, rotate, filter, backdrop-filter;
    transition-timing-function: var(--ease);
    transition-duration: var(--duration);

    @media (hover: hover) {
      &:hover {
        color: var(--color-accent-foreground);
      }
    }
  }

  .footer-copyright {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-copy);
  }
</style>
