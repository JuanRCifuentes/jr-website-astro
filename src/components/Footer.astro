---
import ContainerOuter from './ContainerOuter.astro'
import ContainerInner from './ContainerInner.astro'

const navLinks = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/speaking/', label: 'Speaking' },
  { href: '/uses/', label: 'Uses' },
]
---

<footer class="site-footer">
  <ContainerOuter>
    <div class="footer-body">
      <ContainerInner>
        <div class="footer-row">
          <div class="footer-links">
            {navLinks.map((link) => (
              <a href={link.href} data-astro-prefetch="false" class="footer-link">
                {link.label}
              </a>
            ))}
          </div>
          <p class="footer-copyright">
            &copy; {new Date().getFullYear()} Juan R. Cifuentes. All rights reserved.
          </p>
        </div>
      </ContainerInner>
    </div>
  </ContainerOuter>
</footer>

<style>
  .site-footer {
    margin-top: 8rem;
    flex: none;
  }
  .footer-body {
    border-top: 1px solid var(--color-border);
    padding-block: 2.5rem 4rem;
  }
  .footer-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);

    @media (width >= 48rem) {
      flex-direction: row;
    }
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    font-weight: 500;
    color: var(--color-heading);
  }
  .footer-link {
    transition: var(--transition-colors);

    &:hover {
      color: var(--color-accent-foreground);
    }
  }
  .footer-copyright {
    color: var(--color-copy);
  }
</style>
