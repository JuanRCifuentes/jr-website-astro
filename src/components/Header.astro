---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isHomePage = pathname === '/'
const isActive = (href: string) =>
  href === '/' ? isHomePage : pathname === href || pathname.startsWith(`${href}/`)
const currentLocation = (href: string) =>
  isActive(href) ? (pathname === href ? 'page' : 'location') : undefined

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/articles', label: 'Articles' },
  { href: '/projects', label: 'Projects' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/uses', label: 'Uses' },
]
---

<header id="site-header" class="site-header">
  <div class="header-shell">
    <div class="header-background" aria-hidden="true"></div>
    <div class="header-controls">
      <div class="header-row">
        <div class="header-start">
          <div class="avatar-frame">
            <a href="/" data-astro-prefetch="false" aria-label="Home" class="avatar-link">
              <img
                src="https://jr-w-a.juanrcifuentes.com/assets/avatar.jpg"
                alt=""
                class="avatar"
              />
            </a>
          </div>
        </div>
        <div class="header-middle">
          <!-- Mobile controls stay within thumb reach, above the browser UI. -->
          <button
            id="mobile-menu-toggle"
            class="mobile-corner-button"
            type="button"
            aria-label="Open navigation"
            aria-haspopup="dialog"
            aria-controls="mobile-nav-dialog"
            onclick="document.getElementById('mobile-nav-dialog').showModal()"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="icon-lg">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <!-- Desktop Navigation -->
          <nav id="desktop-nav" class="desktop-nav">
            <ul class="desktop-nav-list">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
              data-astro-prefetch="false"
                    aria-current={currentLocation(item.href)}
                    aria-label={item.href === '/' ? 'Home' : undefined}
                    class:list={[
                      'desktop-nav-link',
                      isActive(item.href) && 'is-active',
                    ]}
                  >
                    {item.href === '/' ? (
                      <span class="home-icon-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon-md">
                          <path d="m3 10 9-7 9 7M5 9v11h5v-6h4v6h5V9" />
                        </svg>
                      </span>
                    ) : item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        <div class="header-end">
          <div class="header-end-inner">
            <button
              type="button"
              id="theme-toggle"
              aria-label="Toggle theme"
              class="mobile-theme-button"
            >
              <svg
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="theme-icon theme-icon-light"
              >
                <path d="M8 12.25A4.25 4.25 0 0 1 12.25 8v0a4.25 4.25 0 0 1 4.25 4.25v0a4.25 4.25 0 0 1-4.25 4.25v0A4.25 4.25 0 0 1 8 12.25v0Z" />
                <path d="M12.25 3v1.5M21.5 12.25H20M18.791 18.791l-1.06-1.06M18.791 5.709l-1.06 1.06M12.25 20v1.5M4.5 12.25H3M6.77 6.77 5.709 5.709M6.77 17.73l-1.061 1.061" fill="none" />
              </svg>
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="theme-icon theme-icon-dark"
              >
                <path d="M17.25 16.22a6.937 6.937 0 0 1-9.47-9.47 7.451 7.451 0 1 0 9.47 9.47ZM12.75 7C17 7 17 2.75 17 2.75S17 7 21.25 7C17 7 17 11.25 17 11.25S17 7 12.75 7Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Dialog -->
<dialog id="mobile-nav-dialog" class="mobile-dialog">
  <div class="mobile-backdrop" onclick="document.getElementById('mobile-nav-dialog').close()"></div>
  <div class="mobile-menu-panel">
    <div class="mobile-menu-header">
      <button aria-label="Close menu" class="mobile-close-button" onclick="document.getElementById('mobile-nav-dialog').close()">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-lg mobile-close-icon">
          <path d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <h2 class="mobile-menu-title">Navigation</h2>
    </div>
    <nav class="mobile-nav">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-astro-prefetch="false"
              aria-current={currentLocation(item.href)}
              class:list={[
                'mobile-nav-link',
                isActive(item.href) && 'is-active',
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu-footer">
      <button id="swap-mobile-controls" type="button" aria-pressed="false" class="swap-button">
        <span>Swap button sides</span>
        <span id="mobile-menu-side" class="swap-label">Menu on right</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    pointer-events: none;
    position: relative;
    z-index: 50;
    height: 4rem;
    flex: none;
  }
  .header-shell {
    position: fixed;
    inset-inline: 0;
    top: 0;
    height: 88px;
  }
  .header-controls {
    margin-inline: auto;
    max-width: 80rem;
    padding-inline: 1rem;
    padding-top: 24px;

    @media (width >= 40rem) {
      padding-inline: 4rem;
    }
    @media (width >= 64rem) {
      padding-inline: 7rem;
    }
  }
  .header-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header-start {
    display: flex;
    flex: 1;
  }
  .header-middle {
    display: flex;
    flex: 1;
    justify-content: flex-end;

    @media (width >= 48rem) {
      justify-content: center;
    }
  }
  .header-end {
    display: flex;
    justify-content: flex-end;

    @media (width >= 48rem) {
      flex: 1;
    }
  }
  .header-end-inner {
    pointer-events: auto;
  }
  .avatar-frame {
    height: 2.5rem;
    width: 2.5rem;
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--color-surface) 90%, transparent);
    padding: 0.125rem;
    box-shadow: var(--ring), var(--shadow-lg);
    backdrop-filter: blur(8px);
  }
  .avatar-link {
    pointer-events: auto;
  }
  .avatar {
    height: 2.25rem;
    width: 2.25rem;
    border-radius: var(--radius-full);
    background-color: var(--color-page);
    object-fit: cover;
  }
  .icon-md {
    height: 1.25rem;
    width: 1.25rem;
  }
  .icon-lg {
    height: 1.5rem;
    width: 1.5rem;
  }
  .desktop-nav {
    pointer-events: auto;
    display: none;

    @media (width >= 48rem) {
      display: block;
    }
  }
  .desktop-nav-list {
    display: flex;
    border-radius: var(--radius-full);
    padding: 0.25rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 500;
    color: var(--color-heading);
  }
  .desktop-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    padding: 0.375rem 0.75rem;
    transition: var(--transition-colors);

    &.is-active {
      background-color: var(--color-control);
      color: var(--color-control-foreground);
    }
    @media (hover: hover) {
      &:not(.is-active):hover {
        color: var(--color-accent-foreground);
      }
    }
  }
  .home-icon-wrap {
    display: flex;
    height: 1.5rem;
    align-items: center;
  }
  .mobile-theme-button {
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--color-surface) 90%, transparent);
    padding: 0.5rem 0.75rem;
    box-shadow: var(--ring), var(--shadow-lg);
    backdrop-filter: blur(8px);
  }
  .mobile-theme-button,
  .theme-icon {
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, translate, scale, rotate, filter, backdrop-filter;
    transition-timing-function: var(--ease);
    transition-duration: var(--duration);
  }
  .theme-icon {
    height: 1.5rem;
    width: 1.5rem;
    stroke: var(--color-copy);
  }
  .theme-icon-light {
    fill: var(--color-page);

    @media (hover: hover) {
      .mobile-theme-button:hover & {
        fill: var(--color-border);
        stroke: var(--color-control);
      }
    }
    @media (prefers-color-scheme: dark) {
      fill: var(--color-accent);
      stroke: var(--color-accent);

      @media (hover: hover) {
        .mobile-theme-button:hover & {
          fill: var(--color-accent-foreground);
          stroke: var(--color-accent-foreground);
        }
      }
    }
  }
  :global(.dark) .theme-icon-light {
    display: none;
  }
  .theme-icon-dark {
    display: none;
    fill: var(--color-heading);

    @media not all and (prefers-color-scheme: dark) {
      fill: color-mix(in oklab, var(--color-accent) 10%, transparent);
      stroke: var(--color-accent-foreground);
    }
    @media (prefers-color-scheme: dark) and (hover: hover) {
      .mobile-theme-button:hover & {
        stroke: var(--color-copy);
      }
    }
  }
  :global(.dark) .theme-icon-dark {
    display: block;
  }
  .header-background {
    position: absolute;
    left: 50%;
    top: 24px;
    width: var(--nav-width, 406px);
    height: 44px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 12px rgb(24 24 27 / 5%);
    transition: width 350ms cubic-bezier(.22, 1, .36, 1),
      height 350ms cubic-bezier(.22, 1, .36, 1),
      top 350ms cubic-bezier(.22, 1, .36, 1),
      border-radius 350ms cubic-bezier(.22, 1, .36, 1);
  }
  #site-header[data-expanded='true'] .header-background {
    width: 100%;
    height: 88px;
    top: 0;
    border-radius: 0;
  }
  .mobile-menu-panel {
    position: fixed;
    z-index: 50;
    border-radius: var(--radius-3xl);
    background-color: var(--color-surface);
    padding: 1.5rem;
    box-shadow: var(--ring);
    right: max(16px, env(safe-area-inset-right));
    bottom: calc(88px + env(safe-area-inset-bottom));
    width: min(320px, calc(100% - 32px));
    max-height: calc(100dvh - 120px - env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  :global(html[data-menu-side='left']) .mobile-menu-panel {
    right: auto;
    left: max(16px, env(safe-area-inset-left));
  }
  .mobile-corner-button {
    pointer-events: auto;
    color: var(--color-heading);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;

  }
  @media (width >= 48rem) {
    .mobile-corner-button { display: none; }
  }
  @media (width < 48rem) {
    :global(body) { padding-bottom: calc(88px + env(safe-area-inset-bottom)); }
    #mobile-menu-toggle, .mobile-theme-button {
      position: fixed;
      bottom: calc(16px + env(safe-area-inset-bottom));
      background: rgb(246 248 251 / 72%);
      border: 1px solid rgb(255 255 255 / 65%);
      box-shadow: inset 0 1px 1px rgb(255 255 255 / 85%), 0 4px 16px rgb(16 42 67 / 14%);
      -webkit-backdrop-filter: blur(20px) saturate(150%);
      backdrop-filter: blur(20px) saturate(150%);
    }
    #mobile-menu-toggle { right: max(16px, env(safe-area-inset-right)); }
    .mobile-theme-button {
      left: max(16px, env(safe-area-inset-left));
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      padding: 0;
    }
    :global(.dark) #mobile-menu-toggle, :global(.dark) .mobile-theme-button {
      background: rgb(51 69 87 / 72%);
      border-color: rgb(255 255 255 / 14%);
      box-shadow: inset 0 1px 1px rgb(255 255 255 / 16%), 0 4px 16px rgb(0 0 0 / 22%);
    }
    :global(html[data-menu-side='left']) #mobile-menu-toggle {
      right: auto;
      left: max(16px, env(safe-area-inset-left));
    }
    :global(html[data-menu-side='left']) .mobile-theme-button {
      left: auto;
      right: max(16px, env(safe-area-inset-right));
    }
    .header-shell { position: absolute; }
    .header-background { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-background { transition: none; }
  }
  dialog#mobile-nav-dialog::backdrop {
    background: transparent;
  }
  .mobile-dialog {
    position: fixed;
    inset: 0;
    margin: 0;
    height: 100%;
    width: 100%;
    max-height: none;
    max-width: none;
    border: none;
    background-color: transparent;
    padding: 0;
  }
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    z-index: 50;
    background-color: color-mix(in oklab, oklch(27.4% .006 286.033) 40%, transparent);
    backdrop-filter: blur(4px);
  }
  :global(.dark) .mobile-backdrop {
    background-color: rgb(0 0 0 / 80%);
  }
  .mobile-menu-header {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-between;
  }
  .mobile-close-button {
    margin: -0.5rem;
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
  }
  .mobile-close-icon {
    color: var(--color-copy);
  }
  .mobile-menu-title {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    font-weight: 500;
    color: var(--color-copy);
  }
  .mobile-nav {
    margin-top: 1.5rem;
  }
  .mobile-nav-list {
    margin-inline: -0.75rem;
    margin-block: -0.5rem;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-heading);

    > :not(:last-child) {
      margin-block-end: 0.25rem;
    }
  }
  .mobile-nav-link {
    display: block;
    border-radius: var(--radius-full);
    padding: 0.5rem 0.75rem;
    transition: var(--transition-colors);

    &.is-active {
      background-color: var(--color-control);
      color: var(--color-control-foreground);
    }
    @media (hover: hover) {
      &:not(.is-active):hover {
        color: var(--color-accent-foreground);
      }
    }
  }
  .mobile-menu-footer {
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .swap-button {
    display: flex;
    min-height: 2.75rem;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: var(--radius-xl);
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-heading);

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-page);
      }
    }
  }
  .swap-label {
    color: var(--color-copy);
  }
</style>

<script>
  // Theme toggle
  function initTheme(root = document.documentElement) {
    const theme = localStorage.getItem('theme') || 'system'
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches

    const dark = theme === 'dark' || (theme === 'system' && systemDark)
    root.classList.toggle('dark', dark)
    root.ownerDocument.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#102A43' : '#FFFFFF')
  }

  function initMobileControls(root = document.documentElement) {
    root.dataset.menuSide = localStorage.getItem('menu-side') === 'left' ? 'left' : 'right'
  }

  // Module scripts run once; bind page-specific behavior after every navigation.
  let pageController: AbortController | undefined

  document.addEventListener('astro:before-swap', (event) => {
    pageController?.abort()
    initTheme(event.newDocument.documentElement)
    initMobileControls(event.newDocument.documentElement)
  })

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    initTheme()
  })

  document.addEventListener('astro:page-load', () => {
    pageController?.abort()
    pageController = new AbortController()
    const { signal } = pageController
    initTheme()
    initMobileControls()

    const mobileMenu = document.getElementById('mobile-nav-dialog') as HTMLDialogElement | null
    mobileMenu?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a[href]')) mobileMenu.close()
    }, { signal })

    const swapButton = document.getElementById('swap-mobile-controls')
    const sideLabel = document.getElementById('mobile-menu-side')
    const updateSideLabel = () => {
      const left = document.documentElement.dataset.menuSide === 'left'
      swapButton?.setAttribute('aria-pressed', String(left))
      if (sideLabel) sideLabel.textContent = left ? 'Menu on left' : 'Menu on right'
    }
    updateSideLabel()
    swapButton?.addEventListener('click', () => {
      const side = document.documentElement.dataset.menuSide === 'left' ? 'right' : 'left'
      localStorage.setItem('menu-side', side)
      initMobileControls()
      updateSideLabel()
    }, { signal })

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark')
      localStorage.setItem('theme', isDark ? 'dark' : 'light')
      initTheme()
    }, { signal })

    const header = document.getElementById('site-header')
    const nav = document.getElementById('desktop-nav')
    if (!header || !nav) return

    const measureNav = () => {
      header.style.setProperty('--nav-width', `${nav.getBoundingClientRect().width}px`)
    }
    const observer = new ResizeObserver(measureNav)
    observer.observe(nav)
    signal.addEventListener('abort', () => observer.disconnect(), { once: true })
    measureNav()

    // Hysteresis prevents flickering near the scroll threshold.
    let expanded = window.scrollY > 48
    const updateBar = () => {
      const next = expanded ? window.scrollY > 16 : window.scrollY > 64
      if (next !== expanded || !header.hasAttribute('data-expanded')) {
        expanded = next
        header.dataset.expanded = String(expanded)
      }
    }
    updateBar()
    window.addEventListener('scroll', updateBar, { passive: true, signal })
  })
</script>
