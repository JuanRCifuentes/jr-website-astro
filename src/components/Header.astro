---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isHomePage = pathname === '/'
const isActive = (href: string) =>
  href === '/' ? isHomePage : pathname === href || pathname.startsWith(`${href}/`)
const currentLocation = (href: string) =>
  isActive(href) ? (pathname === href ? 'page' : 'location') : undefined

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/articles', label: 'Articles' },
  { href: '/projects', label: 'Projects' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/uses', label: 'Uses' },
]
---

<header id="site-header" class="pointer-events-none relative z-50 h-16 flex-none">
  <div class="header-shell fixed inset-x-0 top-0">
    <div class="header-background" aria-hidden="true"></div>
    <div class="header-controls mx-auto max-w-7xl px-4 sm:px-16 lg:px-28">
      <div class="relative flex items-center gap-4">
        <div class="flex flex-1">
          <div class="h-10 w-10 rounded-full bg-surface/90 p-0.5 shadow-lg ring-1 shadow-zinc-800/5 ring-border/70 backdrop-blur-sm">
            <a href="/" aria-label="Home" class="pointer-events-auto">
              <img
                src="https://jr-w-a.juanrcifuentes.com/assets/avatar.jpg"
                alt=""
                class="rounded-full bg-page object-cover h-9 w-9"
              />
            </a>
          </div>
        </div>
        <div class="flex flex-1 justify-end md:justify-center">
          <!-- Mobile controls stay within thumb reach, above the browser UI. -->
          <button
            id="mobile-menu-toggle"
            class="mobile-corner-button pointer-events-auto text-heading md:hidden"
            type="button"
            aria-label="Open navigation"
            aria-haspopup="dialog"
            aria-controls="mobile-nav-dialog"
            onclick="document.getElementById('mobile-nav-dialog').showModal()"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="h-6 w-6">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <!-- Desktop Navigation -->
          <nav id="desktop-nav" class="pointer-events-auto hidden md:block">
            <ul class="flex rounded-full p-1 text-sm font-medium text-heading">
              {navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={currentLocation(item.href)}
                    aria-label={item.href === '/' ? 'Home' : undefined}
                    class:list={[
                      'flex items-center justify-center rounded-full px-3 py-1.5 transition-colors',
                      isActive(item.href)
                        ?'bg-control text-control-foreground'
                        :'hover:text-accent-foreground',
                    ]}
                  >
                    {item.href === '/' ? (
                      <span class="flex h-6 items-center">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5">
                          <path d="m3 10 9-7 9 7M5 9v11h5v-6h4v6h5V9" />
                        </svg>
                      </span>
                    ) : item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        <div class="flex justify-end md:flex-1">
          <div class="pointer-events-auto">
            <button
              type="button"
              id="theme-toggle"
              aria-label="Toggle theme"
              class="mobile-theme-button group rounded-full bg-surface/90 px-3 py-2 shadow-lg ring-1 shadow-zinc-800/5 ring-border/70 backdrop-blur-sm transition"
            >
              <svg
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="h-6 w-6 fill-page stroke-copy transition group-hover:fill-border group-hover:stroke-control dark:hidden [@media(prefers-color-scheme:dark)]:fill-accent [@media(prefers-color-scheme:dark)]:stroke-accent [@media(prefers-color-scheme:dark)]:group-hover:fill-accent-foreground [@media(prefers-color-scheme:dark)]:group-hover:stroke-accent-foreground"
              >
                <path d="M8 12.25A4.25 4.25 0 0 1 12.25 8v0a4.25 4.25 0 0 1 4.25 4.25v0a4.25 4.25 0 0 1-4.25 4.25v0A4.25 4.25 0 0 1 8 12.25v0Z" />
                <path d="M12.25 3v1.5M21.5 12.25H20M18.791 18.791l-1.06-1.06M18.791 5.709l-1.06 1.06M12.25 20v1.5M4.5 12.25H3M6.77 6.77 5.709 5.709M6.77 17.73l-1.061 1.061" fill="none" />
              </svg>
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class="hidden h-6 w-6 fill-heading stroke-copy transition not-[@media_(prefers-color-scheme:dark)]:fill-accent/10 not-[@media_(prefers-color-scheme:dark)]:stroke-accent-foreground dark:block [@media(prefers-color-scheme:dark)]:group-hover:stroke-copy"
              >
                <path d="M17.25 16.22a6.937 6.937 0 0 1-9.47-9.47 7.451 7.451 0 1 0 9.47 9.47ZM12.75 7C17 7 17 2.75 17 2.75S17 7 21.25 7C17 7 17 11.25 17 11.25S17 7 12.75 7Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Dialog -->
<dialog id="mobile-nav-dialog" class="m-0 border-none bg-transparent p-0 fixed inset-0 h-full w-full max-h-none max-w-none">
  <div class="fixed inset-0 z-50 bg-zinc-800/40 backdrop-blur-xs dark:bg-black/80" onclick="document.getElementById('mobile-nav-dialog').close()"></div>
  <div class="mobile-menu-panel fixed z-50 rounded-3xl bg-surface p-6 ring-1 ring-border/70">
    <div class="flex flex-row-reverse items-center justify-between">
      <button aria-label="Close menu" class="-m-2 flex h-11 w-11 items-center justify-center" onclick="document.getElementById('mobile-nav-dialog').close()">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 text-copy">
          <path d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <h2 class="text-sm font-medium text-copy">Navigation</h2>
    </div>
    <nav class="mt-6">
      <ul class="-mx-3 -my-2 space-y-1 text-base text-heading">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentLocation(item.href)}
              class:list={[
                'block rounded-full px-3 py-2 transition-colors',
                isActive(item.href)
                  ?'bg-control text-control-foreground'
                  :'hover:text-accent-foreground',
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</dialog>

<style>
  .header-shell { height: 88px; }
  .header-controls { padding-top: 24px; }
  .header-background {
    position: absolute;
    left: 50%;
    top: 24px;
    width: var(--nav-width, 406px);
    height: 44px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 12px rgb(24 24 27 / 5%);
    transition: width 350ms cubic-bezier(.22, 1, .36, 1),
      height 350ms cubic-bezier(.22, 1, .36, 1),
      top 350ms cubic-bezier(.22, 1, .36, 1),
      border-radius 350ms cubic-bezier(.22, 1, .36, 1);
  }
  #site-header[data-expanded='true'] .header-background {
    width: 100%;
    height: 88px;
    top: 0;
    border-radius: 0;
  }
  .mobile-menu-panel {
    left: max(16px, env(safe-area-inset-left));
    bottom: calc(88px + env(safe-area-inset-bottom));
    width: min(320px, calc(100% - 32px));
    max-height: calc(100dvh - 120px - env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .mobile-corner-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: 0 4px 16px rgb(16 42 67 / 10%);
  }
  @media (width >= 48rem) {
    .mobile-corner-button { display: none; }
  }
  @media (width < 48rem) {
    :global(body) { padding-bottom: calc(88px + env(safe-area-inset-bottom)); }
    #mobile-menu-toggle, .mobile-theme-button {
      position: fixed;
      bottom: calc(16px + env(safe-area-inset-bottom));
    }
    #mobile-menu-toggle { left: max(16px, env(safe-area-inset-left)); }
    .mobile-theme-button {
      right: max(16px, env(safe-area-inset-right));
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      padding: 0;
      background: var(--color-surface);
    }
    .header-shell { position: absolute; }
    .header-background { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-background { transition: none; }
  }
  dialog#mobile-nav-dialog::backdrop {
    background: transparent;
  }
</style>

<script>
  // Theme toggle
  function initTheme(root = document.documentElement) {
    const theme = localStorage.getItem('theme') || 'system'
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches

    root.classList.toggle('dark', theme === 'dark' || (theme === 'system' && systemDark))
  }

  // Module scripts run once; bind page-specific behavior after every navigation.
  let pageController: AbortController | undefined

  document.addEventListener('astro:before-swap', (event) => {
    pageController?.abort()
    initTheme(event.newDocument.documentElement)
  })

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    initTheme()
  })

  document.addEventListener('astro:page-load', () => {
    pageController?.abort()
    pageController = new AbortController()
    const { signal } = pageController
    initTheme()

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark')
      localStorage.setItem('theme', isDark ? 'dark' : 'light')
    }, { signal })

    const header = document.getElementById('site-header')
    const nav = document.getElementById('desktop-nav')
    if (!header || !nav) return

    const measureNav = () => {
      header.style.setProperty('--nav-width', `${nav.getBoundingClientRect().width}px`)
    }
    const observer = new ResizeObserver(measureNav)
    observer.observe(nav)
    signal.addEventListener('abort', () => observer.disconnect(), { once: true })
    measureNav()

    // Hysteresis prevents flickering near the scroll threshold.
    let expanded = window.scrollY > 48
    const updateBar = () => {
      const next = expanded ? window.scrollY > 16 : window.scrollY > 64
      if (next !== expanded || !header.hasAttribute('data-expanded')) {
        expanded = next
        header.dataset.expanded = String(expanded)
      }
    }
    updateBar()
    window.addEventListener('scroll', updateBar, { passive: true, signal })
  })
</script>
