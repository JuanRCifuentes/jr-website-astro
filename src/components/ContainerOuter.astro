---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={['container-outer', className]}>
  <div class="container-outer-content">
    <slot />
  </div>
</div>

<style>
  .container-outer {
    @media (width >= 40rem) {
      padding-inline: 2rem;
    }
  }

  .container-outer-content {
    margin-inline: auto;
    width: 100%;
    max-width: 80rem;

    @media (width >= 64rem) {
      padding-inline: 2rem;
    }
  }
</style>
