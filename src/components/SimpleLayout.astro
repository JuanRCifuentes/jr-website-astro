---
import Container from './Container.astro'

interface Props {
  title: string
  intro: string
}

const { title, intro } = Astro.props
const hasContent = Astro.slots.has('default')
---

<Container class="simple-layout">
  <header class="simple-layout-header">
    <h1 class="simple-layout-title">
      {title}
    </h1>
    <p class="simple-layout-intro">
      {intro}
    </p>
  </header>
  {hasContent && (
    <div class="simple-layout-content">
      <slot />
    </div>
  )}
</Container>

<style>
  .simple-layout {
    margin-top: 4rem;
  }
  .simple-layout-header {
    max-width: 42rem;
  }
  .simple-layout-title {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }
  .simple-layout-intro {
    margin-top: 1.5rem;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-copy);
  }
  .simple-layout-content {
    margin-top: 4rem;
  }
  @media (width >= 40rem) {
    .simple-layout {
      margin-top: 8rem;
    }
    .simple-layout-title {
      font-size: var(--text-5xl);
      line-height: var(--text-5xl--line-height);
    }
    .simple-layout-content {
      margin-top: 5rem;
    }
  }
</style>
