---
import type { HTMLTag } from 'astro/types'

interface Props {
  as?: HTMLTag
  decorate?: boolean
  class?: string
  dateTime?: string
}

const { as: Tag = 'p', decorate = false, class: className, dateTime } = Astro.props
---

<Tag
  datetime={Tag === 'time' ? dateTime : undefined}
  class:list={[className, 'card-eyebrow', decorate && 'card-eyebrow-decorated']}
>
  <slot />
</Tag>

<style>
  .card-eyebrow {
    position: relative;
    z-index: 10;
    order: -9999;
    margin-bottom: 0.75rem;
    align-items: center;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-copy);
  }
  /* :where() keeps display at zero specificity so a page-supplied class can hide it. */
  :where(.card-eyebrow) {
    display: flex;
  }
  .card-eyebrow-decorated {
    padding-left: 0.875rem;

    &::before {
      content: '';
      position: absolute;
      left: 0;
      width: 0.125rem;
      height: 1rem;
      border-radius: var(--radius-full);
      background-color: var(--color-accent);
    }
  }
</style>
