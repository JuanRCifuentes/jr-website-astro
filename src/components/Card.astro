---
interface Props {
  as?: string
  class?: string
}

const { as: Tag = 'div', class: className } = Astro.props
---

<Tag class:list={[className, 'card']}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
</style>
