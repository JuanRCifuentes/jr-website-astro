---
interface Props {
  href: string
}

const { href } = Astro.props
---

<div class="card-link-backdrop"></div>
<a href={href}>
  <span class="card-link-hit-area"></span>
  <span class="card-link-label"><slot /></span>
</a>

<style>
  .card-link-backdrop,
  .card-link-hit-area {
    position: absolute;
    inset: -1.5rem -1rem;
    border-radius: var(--radius-2xl);

    @media (width >= 40rem) {
      inset-inline: -1.5rem;
    }
  }
  .card-link-backdrop {
    scale: 95%;
    background-color: var(--color-page);
    opacity: 0;
    transition: opacity var(--duration), scale var(--duration);
  }
  .card-link-hit-area {
    z-index: 20;
  }
  .card-link-label {
    position: relative;
    z-index: 10;
  }
  :global(.card:hover) .card-link-backdrop {
    scale: 100%;
    opacity: 1;
  }
</style>
