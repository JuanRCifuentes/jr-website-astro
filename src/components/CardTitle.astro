---
import CardLink from './CardLink.astro'

interface Props {
  as?: 'h2' | 'h3'
  href?: string
}

const { as: Tag = 'h2', href } = Astro.props
---

<Tag class="card-title">
  {href ? <CardLink href={href}><slot /></CardLink> : <slot />}
</Tag>

<style>
  .card-title {
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }
</style>
