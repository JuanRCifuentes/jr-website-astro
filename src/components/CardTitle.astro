---
import CardLink from './CardLink.astro'

interface Props {
  as?: 'h2' | 'h3'
  href?: string
}

const { as: Tag = 'h2', href } = Astro.props
---

{Tag === 'h3' ? (
  <h3 class="card-title">
    {href ? <CardLink href={href}><slot /></CardLink> : <slot />}
  </h3>
) : (
  <h2 class="card-title">
    {href ? <CardLink href={href}><slot /></CardLink> : <slot />}
  </h2>
)}

<style>
  .card-title {
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }
</style>
